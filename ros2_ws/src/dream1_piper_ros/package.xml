<?xml version="1.0"?>
<package format="3">
  <name>dream1_piper_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 Jazzy gateway and bringup for the bimanual Piper station.</description>
  <maintainer email="robotics@example.invalid">Dream1 Piper maintainers</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>agx_arm_ctrl</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>python3-websockets</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
