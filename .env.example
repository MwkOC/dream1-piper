# Copy your key into .env only. Never put a real key in this example file.
DREAM_API_KEY=
DREAM_CHECKPOINT=dreamlabs/dream-1-beta
# The URDF defines nominal left_tcp and right_tcp frames for this read-only test.
PIPER_URDF=assets/piper/piper.urdf
PIPER_LEFT_BASE=left_base_link
PIPER_LEFT_TCP=left_tcp
PIPER_RIGHT_BASE=right_base_link
PIPER_RIGHT_TCP=right_tcp
