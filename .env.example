# Copy your key into .env only. Never put a real key in this example file.
DREAM_API_KEY=
DREAM_CHECKPOINT=dreamlabs/dream-1-beta
# Custom bimanual URDF/TCP is selected by robot.urdf in configs/bipiper.yaml.
# The URDF defines nominal left_tcp and right_tcp frames for inference and IK.
PIPER_URDF=assets/piper/piper.urdf
PIPER_LEFT_BASE=left_base_link
PIPER_LEFT_TCP=left_tcp
PIPER_RIGHT_BASE=right_base_link
PIPER_RIGHT_TCP=right_tcp

# Local profile: localhost, HTTP, and dummy credentials. Use
# compose.production.yaml with real credentials and TLS for LAN deployment.
RSTACK_ENVIRONMENT=development
RSTACK_UI_HOST=127.0.0.1
RSTACK_UI_PORT=8443
RSTACK_UI_OPERATOR_TOKEN=local-operator
RSTACK_WORKER_TOKEN=local-worker
RSTACK_SESSION_SECRET=local-only-session-secret-change-for-deployment
RSTACK_UI_TLS_CERT=
RSTACK_UI_TLS_KEY=
RSTACK_UI_CA_CERT=
RSTACK_ROBOT_CONFIG=configs/app_robot.yaml
RSTACK_DREAM_CONFIG=experiments/piper_station_worker/config/dream.yaml
RSTACK_ROS_BRIDGE_URL=ws://127.0.0.1:8766
RSTACK_CONTROL_HZ=20
RSTACK_TELEOP_MAX_HZ=30
RSTACK_TELEOP_LINEAR_LIMIT_M_S=0.05
RSTACK_TELEOP_ANGULAR_LIMIT_RAD_S=0.25
RSTACK_TELEOP_DEADMAN_TIMEOUT_MS=250
RSTACK_METRICS_QUEUE_SIZE=10000
RSTACK_CAN_LEFT=can0
RSTACK_CAN_RIGHT=can1
RSTACK_CAMERA_LEFT_DEVICE=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:1:1.0-video-index0
RSTACK_CAMERA_TOP_DEVICE=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:3:1.0-video-index0
RSTACK_CAMERA_RIGHT_DEVICE=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:2:1.0-video-index0
RSTACK_ROBOT_SPEED_PERCENT=20
RSTACK_HOME_DURATION_S=3.0
RSTACK_HOME_TOLERANCE_RAD=0.08

# Worker defaults to action mode, but station still requires Validate → Arm → Start.
RSTACK_DREAM_MODE=action
# Optional overrides; leave unset to use checkpoint/task from Dream YAML.
# RSTACK_DREAM_MODEL=dreamlabs/dream-1-beta
# RSTACK_DREAM_TASK="Pick up the purple bunch of grapes and place it in the yellow basket."
RSTACK_DREAM_STATION_URL=ws://127.0.0.1:8443/api/v1/worker
RSTACK_DREAM_METRICS_WINDOW=200

# Local-only PostgreSQL credentials. Replace before any shared deployment.
POSTGRES_IMAGE=postgres:18.7-bookworm
POSTGRES_DB=dream1_piper
POSTGRES_USER=dream1_piper
POSTGRES_PASSWORD=local-db-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dream1_piper:local-db-only@127.0.0.1:5432/dream1_piper

# Host devices/cert paths mapped by Compose. Replace camera paths for this rig.
CAMERA_LEFT_HOST=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:3:1.0-video-index0
CAMERA_TOP_HOST=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:1:1.0-video-index0
CAMERA_RIGHT_HOST=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:2:1.0-video-index0
VIDEO_GID=44
CAMERA_LEFT_CONTAINER=/dev/video-left
CAMERA_TOP_CONTAINER=/dev/video-top
CAMERA_RIGHT_CONTAINER=/dev/video-right
# Only used with compose.production.yaml; not needed for local HTTP.
TLS_CERT_HOST=
TLS_KEY_HOST=
TLS_CA_HOST=
RSTACK_METRICS_RETENTION_DAYS=30
