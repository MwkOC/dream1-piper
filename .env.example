# Copy your key into .env only. Never put a real key in this example file.
DREAM_API_KEY=
DREAM_CHECKPOINT=dreamlabs/dream-1-beta
# Custom bimanual URDF/TCP is selected by robot.urdf in configs/bipiper.yaml.
# The URDF defines nominal left_tcp and right_tcp frames for inference and IK.
PIPER_URDF=assets/piper/piper.urdf
PIPER_LEFT_BASE=left_base_link
PIPER_LEFT_TCP=left_tcp
PIPER_RIGHT_BASE=right_base_link
PIPER_RIGHT_TCP=right_tcp

# Worker defaults to action mode; station still requires Validate → Arm → Start.
RSTACK_DREAM_MODE=action
RSTACK_DREAM_MODEL=dreamlabs/dream-1-beta
RSTACK_DREAM_TASK=Pick up the purple bunch of grapes and place it in the yellow basket.
RSTACK_DREAM_STATION_URL=ws://127.0.0.1:8765
RSTACK_DREAM_METRICS_WINDOW=200
RSTACK_DREAM_UI_HOST=127.0.0.1
RSTACK_DREAM_UI_PORT=8080
